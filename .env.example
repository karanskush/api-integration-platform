# All optional locally — the app falls back to in-memory storage and default origins.

# Upstash Redis (required in production; provision via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin of THIS app, used to build absolute pageUrl/mcpUrl in /api/import
# (falls back to the request origin when unset)
PUBLIC_APP_ORIGIN=

# landing-site origin; when set, / redirects there and nav links point at it
# e.g. https://api-integration-platform.vercel.app
NEXT_PUBLIC_SITE_ORIGIN=

# Comma-separated origins allowed to call /api/import and /api/waitlist cross-origin
# (the marketing site). Default: http://localhost:5173
ALLOWED_SITE_ORIGINS=

# Dev-only override for the 24h record TTL, in seconds
SPOTCHECK_TTL_SECONDS=

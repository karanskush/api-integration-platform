# All optional locally — the app falls back to in-memory storage and default origins.

# Upstash Redis (required in production; provision via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon Postgres (required in production for persistence/billing features;
# provision via the Vercel Marketplace). Without it, persistence/billing
# routes return a clear "not configured" response — the anonymous Phase 0
# flow (import/playground/MCP) is unaffected either way.
DATABASE_URL=

# Clerk (required in production for accounts; provision via the Vercel
# Marketplace). Without both set, auth UI/middleware are skipped entirely —
# the anonymous Phase 0 flow is unaffected either way.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Upstash QStash (job queue — waitlist welcome email today). Without it,
# waitlist signups still persist, they just don't enqueue an email job.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Resend (transactional email). Without it, the waitlist email job route
# returns "not configured" instead of sending.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=

# Vercel Blob (raw spec snapshots, content-hash addressed, PRIVATE access).
# Provision via the Vercel dashboard → Storage. Without it, spec_versions.
# blob_ref stays null: imports still work, but the original bytes aren't kept
# for drift diffing or re-normalization after a parser change.
BLOB_READ_WRITE_TOKEN=

# Stripe (billing). Both keys required together for billing to be
# considered configured. Price ids are per-plan; test vs live ids differ.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Metered MCP credits. Create a Billing Meter in Stripe and put its event name
# here; usage is reported once per org per closed UTC day by the
# /api/cron/report-usage job. Unset means no usage is reported at all (rather
# than events being dropped into a meter that doesn't exist).
STRIPE_METER_EVENT_NAME=
STRIPE_PRICE_LAUNCH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# Master secret for CI sync tokens and vaulted credentials. One key, expanded
# with HKDF into purpose-scoped subkeys (see src/lib/keys.ts) — no other
# crypto secret is needed. Without it, CI sync and the credential vault return
# "not configured"; nothing else is affected.
#   openssl rand -base64 32
# Rotating this invalidates every issued CI token and every wrapped credential,
# so prefer per-object rotation (apis.ci_token_version) where possible.
SPOTCHECK_MASTER_KEY=

# Scheduled jobs (vercel.json declares the cron). Vercel sends this as
# `Authorization: Bearer $CRON_SECRET`. Without it /api/cron/* returns 503 —
# it fails CLOSED, so a deployment that forgets this has no open cron endpoint.
#   openssl rand -hex 32
CRON_SECRET=

# Scheduled re-verification tuning (see src/lib/reverify.ts). Defaults: a
# weekly cadence, 5 APIs per invocation (stalest first, capped at 25).
SCHEDULED_VERIFY_INTERVAL_HOURS=
SCHEDULED_VERIFY_BATCH=

# Everything that talks to a model goes through the Vercel AI Gateway: the ask
# assistant (src/lib/ask.ts), the deep-analysis enrichment pass
# (src/lib/deepEnrich.ts), and clarification triage/synthesis (src/lib/clarify).
#
# Three ways to authenticate, any one is enough:
#   * set AI_GATEWAY_API_KEY below (local dev, non-Vercel deploys)
#   * deploy on Vercel, which injects an OIDC token automatically
#   * run `vercel env pull`, which writes a short-lived VERCEL_OIDC_TOKEN
#     into .env.local — no key needed locally either
#
# With none of them, the ask routes return "not configured" and deep analysis
# falls back to heuristics only. Nothing else is affected.
AI_GATEWAY_API_KEY=

# Model for every model-backed feature, as a Gateway "provider/model" string.
# Defaults to the current Claude Sonnet if unset.
SPOTCHECK_ASK_MODEL=

# Direct OpenAI credential, bypassing the Gateway entirely. Only for teams that
# hold an OpenAI key but not the purchased Gateway credits that routing it
# through the Gateway (BYOK) requires — otherwise prefer the Gateway, which adds
# failover and spend tracking for free.
#
# Engages ONLY when this key is set AND SPOTCHECK_ASK_MODEL names an OpenAI
# model ("openai/gpt-5-mini", or a bare "gpt-5-mini"). With any other model the
# key is ignored and the call still goes to the Gateway, so this can never
# silently swap the model you asked for.
OPENAI_API_KEY=

# Optional overrides for plan limits (see src/lib/plans.ts) — defaults are
# reasonable placeholders until real numbers are confirmed.
PLAN_MAX_APIS_FREE=
PLAN_MAX_APIS_LAUNCH=
PLAN_MAX_APIS_PRO=
PLAN_MAX_APIS_TEAM=
PLAN_MAX_APIS_BUSINESS=

# Public origin of THIS app, used to build absolute pageUrl/mcpUrl in /api/import
# (falls back to the request origin when unset)
PUBLIC_APP_ORIGIN=

# landing-site origin; when set, / redirects there and nav links point at it
# e.g. https://api-integration-platform.vercel.app
NEXT_PUBLIC_SITE_ORIGIN=

# Comma-separated origins allowed to call /api/import and /api/waitlist cross-origin
# (the marketing site). Default: http://localhost:5173
ALLOWED_SITE_ORIGINS=

# Dev-only override for the 24h record TTL, in seconds
SPOTCHECK_TTL_SECONDS=
